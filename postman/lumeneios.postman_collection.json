{
  "info": {
    "name": "LumenEIOS Local and PayPal Sandbox",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "role",
      "value": "principal"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "principal_token",
      "value": ""
    },
    {
      "key": "teacher_token",
      "value": ""
    },
    {
      "key": "student_token",
      "value": ""
    },
    {
      "key": "document_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login and save token for role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(pm.variables.get(\"role\") + \"_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Principal quote for 12 seats",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{principal_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/assistant/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"message\":\"How much does a PayPal subscription for 12 teachers cost?\",\"search_library\":false}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"USD 80.00 and 12-seat review link\", () => { const reply = pm.response.json(); pm.expect(reply.answer).to.include(\"USD 80.00\"); pm.expect(reply.links[0].path).to.include(\"teacherSeats=12\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Teacher cannot start checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacher_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/subscriptions/start",
        "body": {
          "mode": "raw",
          "raw": "{\"teacher_count\":12}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Student cannot search staff library",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/assistant/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"message\":\"What is the retake policy?\",\"search_library\":true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Subscription status before or after approval",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{principal_token}}"
          }
        ],
        "url": "{{base_url}}/subscriptions/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns subscription records\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Run manually · creates PayPal sandbox subscriptions",
      "item": [
        {
          "name": "Start sandbox checkout for 12 seats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{principal_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/subscriptions/start",
            "body": {
              "mode": "raw",
              "raw": "{\"teacher_count\":12}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Returns two PayPal approval links\", () => pm.expect(pm.response.json().approve_links).to.have.lengthOf(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "School document search",
      "item": [
        {
          "name": "Upload a policy PDF · select local file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{principal_token}}"
              }
            ],
            "url": "{{base_url}}/documents/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "doc_type",
                  "type": "text",
                  "value": "school_policy"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"document_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish approved PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{principal_token}}"
              }
            ],
            "url": "{{base_url}}/documents/{{document_id}}/publish-to-assistant"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Published passages\", () => pm.expect(pm.response.json().indexed_passages).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask about the published policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/assistant/chat",
            "body": {
              "mode": "raw",
              "raw": "{\"message\":\"What is the retake policy?\",\"search_library\":true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cites a PDF page\", () => pm.expect(pm.response.json().citations.length).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
