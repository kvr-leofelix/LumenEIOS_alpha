# LumenEIOS Environment Configuration Template

APP_NAME=LumenEIOS
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-me-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database: SQLite for instant zero-dependency local runs, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./lumeneios.db
# DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Object Storage (MinIO or AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=lumeneios-documents
STORAGE_LOCAL_DIR=./storage_uploads

# OCR Engine
OCR_CONFIDENCE_THRESHOLD=0.85
HF_TOKEN=
DEFAULT_VISION_MODEL=microsoft/trocr-base-handwritten
QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
QWEN_QUESTION_STUDIO_MODEL_ID=qwen2.5vl:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# AI / LLM Provider
LLM_PROVIDER=deterministic
LLM_API_KEY=

# Optional Neo4j Knowledge Graph
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Redis Cache / Tasks
REDIS_URL=redis://localhost:6379/0

# Local demo shortcuts (use only with sample data)
DEMO_MODE=false
VITE_DEMO_MODE=false
# Optional development root login for sample data. Accepts LEOFELIX or leofelix@lumeneios.demo.
DEMO_ROOT_PASSWORD=

# PayPal subscriptions (sandbox first; set PAYPAL_ENV=live only for real payments)
# Get credentials from PayPal Developer > Apps & Credentials > Sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_PLAN_ID=
PAYPAL_SEAT_PLAN_ID=
PAYPAL_RETURN_URL=http://localhost:3000/subscription/return
PAYPAL_CANCEL_URL=http://localhost:3000/subscription/cancel

# Optional search for approved school PDFs
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
